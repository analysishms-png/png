REM Backup each table
set success_count=0
set error_count=0

for /l %%i in (1,1,271) do (
    set "table_name=!tables[%%i]!"
    set "output_file=%BACKUP_DIR%\!table_name!_%TIMESTAMP%.csv"
    
    echo Backing up table [%%i/271]: !table_name! >> "%LOG_FILE%"
    
    REM Execute SQL command to backup table
    sqlcmd -S %SERVER_NAME% -E -Q "USE %DATABASE_NAME%; SELECT * FROM !table_name!;" -o "!output_file!" -s"," -w 7000
    
    REM Check if backup was successful
    if !errorlevel! equ 0 (
        echo   SUCCESS: !table_name! >> "%LOG_FILE%"
        set /a success_count+=1
    ) else (
        echo   ERROR: Failed to backup !table_name! >> "%LOG_FILE%"
        set /a error_count+=1
    )
)

